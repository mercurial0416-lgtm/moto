# Copy to .github/workflows/build-signed.yml after uploading this source ZIP to the repository.
name: MOTO HUB signed release
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  apk:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: gradle/actions/setup-gradle@v4
      - name: Extract source
        run: unzip -q MOTO-HUB-4.0.0-alpha6-ak-source.zip
      - name: Prepare signing key
        env:
          KEYSTORE_B64: ${{ secrets.MOTO_KEYSTORE_BASE64 }}
        run: |
          test -n "$KEYSTORE_B64" || { echo 'Missing signing keystore secret'; exit 1; }
          printf '%s' "$KEYSTORE_B64" | base64 -d > "$RUNNER_TEMP/moto-release.jks"
      - name: Build signed release
        working-directory: MOTO-HUB
        env:
          MOTO_SIGNING_STORE_FILE: ${{ runner.temp }}/moto-release.jks
          MOTO_SIGNING_STORE_PASSWORD: ${{ secrets.MOTO_STORE_PASSWORD }}
          MOTO_SIGNING_KEY_ALIAS: ${{ secrets.MOTO_KEY_ALIAS }}
          MOTO_SIGNING_KEY_PASSWORD: ${{ secrets.MOTO_KEY_PASSWORD }}
        run: |
          chmod +x gradlew
          ./gradlew :app:assembleRelease --no-daemon
          "$ANDROID_HOME/build-tools/36.0.0/apksigner" verify --verbose app/build/outputs/apk/release/app-release.apk
          "$ANDROID_HOME/build-tools/36.0.0/apksigner" verify --print-certs app/build/outputs/apk/release/app-release.apk
      - uses: actions/upload-artifact@v4
        with:
          name: MOTO-HUB-Alpha6-AK-signed-APK
          path: MOTO-HUB/app/build/outputs/apk/release/app-release.apk
          if-no-files-found: error
