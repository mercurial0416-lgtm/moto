<?xml version="1.0" encoding="utf-8"?>
<!-- Explicit fixed-height action capsule even inside a launcher cell taller than 1 row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:gravity="center_vertical"
 android:padding="2dp" android:background="@android:color/transparent">
 <LinearLayout android:layout_width="match_parent" android:layout_height="47dp"
  android:orientation="horizontal" android:gravity="center_vertical"
  android:padding="5dp" android:background="@drawable/widget_background">
  <TextView android:id="@+id/quick_ride" android:layout_width="0dp"
   android:layout_height="37dp" android:layout_weight="1.25"
   android:background="@drawable/widget_primary" android:gravity="center"
   android:text="▶ 출발" android:textSize="11sp" android:textStyle="bold"
   android:textColor="#121417" android:maxLines="2"
   android:contentDescription="동의 후 주행 기록 시작 및 내비 실행"/>
  <TextView android:id="@+id/quick_nav" android:layout_width="0dp"
   android:layout_height="37dp" android:layout_weight="1"
   android:layout_marginStart="5dp" android:background="@drawable/widget_secondary"
   android:gravity="center" android:text="↗ 내비" android:textSize="11sp"
   android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="2"
   android:contentDescription="기본 내비만 실행"/>
 </LinearLayout>
</LinearLayout>
