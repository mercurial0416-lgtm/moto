<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="horizontal" android:gravity="center_vertical"
 android:padding="5dp" android:background="@drawable/widget_background">
 <TextView android:id="@+id/quick_ride" android:layout_width="0dp"
  android:layout_height="match_parent" android:layout_weight="1"
  android:background="@drawable/widget_primary" android:gravity="center"
  android:text="▶ 기록" android:textSize="12sp" android:textStyle="bold"
  android:textColor="#111419" android:maxLines="1" android:contentDescription="라이딩 기록 시작 또는 확인"/>
 <TextView android:id="@+id/quick_nav" android:layout_width="0dp"
  android:layout_height="match_parent" android:layout_weight="1"
  android:layout_marginStart="5dp" android:background="@drawable/widget_secondary"
  android:gravity="center" android:text="↗ 내비" android:textSize="12sp"
  android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1"
  android:contentDescription="기본 내비게이션 바로 실행"/>
</LinearLayout>
