<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent host means launcher resize does not produce an enormous dark rectangle. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:gravity="center_vertical"
 android:padding="2dp" android:background="@android:color/transparent">
 <LinearLayout android:layout_width="match_parent" android:layout_height="72dp"
  android:background="@drawable/widget_background"
  android:orientation="vertical" android:paddingStart="9dp" android:paddingEnd="9dp"
  android:paddingTop="6dp" android:paddingBottom="6dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="17dp"
   android:orientation="horizontal" android:gravity="center_vertical">
   <TextView android:id="@+id/widget_home" android:layout_width="0dp"
    android:layout_height="match_parent" android:layout_weight="1"
    android:text="MOTO HUB" android:textColor="#FF893B"
    android:textStyle="bold" android:textSize="11sp" android:gravity="center_vertical"
    android:contentDescription="MOTO HUB 홈 열기"/>
   <TextView android:id="@+id/widget_nav_choice" android:layout_width="wrap_content"
    android:layout_height="match_parent" android:gravity="center_vertical"
    android:text="기본 내비" android:textColor="#98A4B4" android:textSize="10sp"
    android:contentDescription="기본 내비 선택 변경"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="37dp"
   android:layout_marginTop="5dp" android:orientation="horizontal">
   <TextView android:id="@+id/widget_ride" android:layout_width="0dp"
    android:layout_height="match_parent" android:layout_weight="1.25"
    android:background="@drawable/widget_primary" android:gravity="center"
    android:text="▶ 기록+내비" android:textColor="#121417" android:textSize="12sp"
    android:textStyle="bold" android:maxLines="1" android:contentDescription="동의 후 주행 기록 및 선택한 내비 실행"/>
   <TextView android:id="@+id/widget_nav" android:layout_width="0dp"
    android:layout_height="match_parent" android:layout_weight="1"
    android:layout_marginStart="6dp" android:background="@drawable/widget_secondary"
    android:gravity="center" android:text="↗ 내비만" android:textColor="#FFFFFF"
    android:textSize="12sp" android:textStyle="bold" android:maxLines="1"
    android:contentDescription="GPS 기록을 자동 시작하지 않고 내비만 실행"/>
  </LinearLayout>
 </LinearLayout>
</LinearLayout>
