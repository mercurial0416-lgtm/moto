<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="2dp" android:background="@android:color/transparent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="120dp" android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
      <TextView android:id="@+id/widget_home" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="@string/widget_brand" android:textColor="@color/widget_text" android:textStyle="bold" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" android:contentDescription="@string/widget_home_description" />
      <TextView android:id="@+id/widget_nav_choice" android:layout_width="wrap_content" android:layout_height="match_parent" android:paddingStart="10dp" android:gravity="center" android:text="@string/widget_choose_nav" android:textColor="@color/widget_muted" android:textSize="12sp" android:maxLines="1" android:contentDescription="@string/widget_choose_nav_description" android:paddingEnd="0dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal">
      <TextView android:id="@+id/widget_ride" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:background="@drawable/widget_primary" android:gravity="center" android:drawablePadding="5dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="@string/widget_ride" android:textColor="@color/widget_on_primary" android:textSize="14sp" android:textStyle="bold" android:maxLines="2" android:contentDescription="@string/widget_ride_description" />
      <TextView android:id="@+id/widget_nav" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/widget_secondary" android:gravity="center" android:drawablePadding="5dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:text="@string/widget_nav" android:textColor="@color/widget_text" android:textSize="14sp" android:textStyle="bold" android:maxLines="2" android:contentDescription="@string/widget_nav_description" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>