<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="13dp"
 android:background="@drawable/widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/widget_home" android:layout_width="0dp"
   android:layout_height="wrap_content" android:layout_weight="1"
   android:text="MOTO HUB" android:textColor="#FF8A32"
   android:textStyle="bold" android:textSize="13sp"
   android:contentDescription="MOTO HUB 홈 열기" android:paddingBottom="4dp"/>
  <TextView android:id="@+id/widget_garage" android:layout_width="wrap_content"
   android:layout_height="wrap_content" android:text="차고 ›" android:textColor="#B8C1CC"
   android:textSize="11sp" android:padding="5dp"
   android:contentDescription="내 바이크 변경과 차고 열기"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_bike_name" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:text="내 바이크" android:textColor="#FFFFFF"
  android:textStyle="bold" android:textSize="19sp" android:maxLines="1"
  android:ellipsize="end"/>
 <TextView android:id="@+id/widget_bike_status" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:text="차고 데이터를 확인하는 중"
  android:textColor="#AAB5C2" android:textSize="11sp" android:paddingTop="2dp"
  android:maxLines="1" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_connection_status" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:text="GPS 확인 필요 · OBD 연결 안 됨"
  android:textColor="#93CDB9" android:textSize="11sp" android:paddingTop="5dp"
  android:paddingBottom="7dp" android:maxLines="1" android:ellipsize="end"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
  android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/widget_ride" android:layout_width="0dp"
   android:layout_height="match_parent" android:layout_weight="2"
   android:background="@drawable/widget_primary" android:gravity="center"
   android:text="라이딩 시작  ›" android:textColor="#FFFFFF" android:textSize="14sp"
   android:textStyle="bold" android:contentDescription="라이딩 동의 화면 열기"/>
  <TextView android:id="@+id/widget_nav" android:layout_width="0dp"
   android:layout_height="match_parent" android:layout_weight="1"
   android:layout_marginStart="6dp" android:background="@drawable/widget_secondary"
   android:gravity="center" android:text="내비" android:textColor="#FFFFFF"
   android:textSize="13sp" android:contentDescription="설정된 외부 내비 열기"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_quick_row"
  android:layout_width="match_parent" android:layout_height="36dp"
  android:layout_marginTop="7dp" android:orientation="horizontal"
  android:visibility="gone">
  <TextView android:id="@+id/widget_fuel" android:layout_width="0dp"
   android:layout_height="match_parent" android:layout_weight="1"
   android:background="@drawable/widget_secondary" android:gravity="center"
   android:text="주유 기록" android:textColor="#FFFFFF"
   android:textSize="12sp" android:contentDescription="주유 기록 작성"/>
  <TextView android:id="@+id/widget_service" android:layout_width="0dp"
   android:layout_height="match_parent" android:layout_weight="1"
   android:layout_marginStart="6dp" android:background="@drawable/widget_secondary"
   android:gravity="center" android:text="정비 기록" android:textColor="#FFFFFF"
   android:textSize="12sp" android:contentDescription="정비 기록 작성"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_cost" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:text="" android:textColor="#FFB16B"
  android:textSize="11sp" android:paddingTop="5dp" android:maxLines="1"
  android:ellipsize="end" android:visibility="gone"/>
</LinearLayout>
